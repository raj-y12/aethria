# Aethria backend environment variables.
# Generated from backend/config.py REGISTRY — do not edit by hand.
# Regenerate with: python -c "import env_config; print(env_config.render_env_example())" > .env.example
# Secrets and required values are shown with placeholders; fill them in your real .env.

# === Legacy Supabase compatibility ===
# Deprecated compatibility switch; normal runtime persistence uses DATABASE_URL. [bool, optional]
USE_SUPABASE_STORAGE=0
# Optional project URL for isolated legacy/test tooling. [str, optional]
SUPABASE_URL=
# Optional service-role key for isolated legacy/test tooling. [secret, optional]
SUPABASE_SERVICE_ROLE_KEY=
# Optional anon key for isolated legacy/test tooling. [secret, optional]
SUPABASE_ANON_KEY=
# Optional legacy URL fallback; not used by normal runtime. [str, optional]
VITE_SUPABASE_URL=
# Legacy transport retry attempts. [int, optional]
SUPABASE_RETRY_ATTEMPTS=6
# Legacy max backoff between retries. [float, optional]
SUPABASE_MAX_RETRY_DELAY_SECONDS=1.5
# Legacy HTTP pool max connections. [int, optional]
SUPABASE_POOL_MAX_CONNECTIONS=40
# Legacy HTTP pool max keepalive connections. [int, optional]
SUPABASE_POOL_MAX_KEEPALIVE=20
# Legacy HTTP keepalive expiry (seconds). [int, optional]
SUPABASE_POOL_KEEPALIVE_EXPIRY=60
# Deprecated database URL accepted only by historical tooling. [secret, optional]
SUPABASE_DB_URL=

# === Core / storage ===
# Root dir for local fallback data. [str, optional]
DATA_DIR=data
# Local fallback dir for the portfolio JSON store. [str, optional]
PORTFOLIO_DIR=data/portfolio
# Local fallback path for the startups store (dev only). [str, optional]
STORAGE_PATH=data/startups.json
# Local fallback path for per-user settings (dev only). [str, optional]
SETTINGS_PATH=data/settings.json
# Local imported production snapshot mode; keeps repositories readable and disables autonomous writers. [bool, optional]
LOCAL_SNAPSHOT_READ_ONLY=0
# Optional path to the immutable local snapshot backup used by reset-local-snapshot. [str, optional]
LOCAL_SNAPSHOT_GOLDEN_BACKUP_PATH=

# === OpenAI / models ===
# OpenAI API key. Missing key = pipeline skipped (no silent failure). [secret, REQUIRED]
OPENAI_API_KEY=
# Model for scout personas. [str, optional]
SCOUT_MODEL=gpt-5-nano
# Model for reviewer personas. [str, optional]
REVIEWER_MODEL=gpt-5-nano
# Model for partner LLM edge cases. [str, optional]
PARTNER_MODEL=gpt-5-nano
# Model for the meta-agent. [str, optional]
META_AGENT_MODEL=gpt-5-nano

# === Auth (Clerk) ===
# Clerk JWKS endpoint for RS256 JWT verification. [str, REQUIRED]
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
# Expected JWT issuer; mismatches fail closed. [str, optional]
CLERK_ISSUER=
# Optional expected JWT audience. [str, optional]
CLERK_AUDIENCE=
# Clerk backend API secret (optional). [secret, optional]
CLERK_SECRET_KEY=
# Clock-skew leeway for JWT validation. [int, optional]
CLERK_JWT_LEEWAY_SECONDS=60

# === Server / CORS / SSE ===
# Comma-separated extra CORS origins for production domains. [str, optional]
ALLOWED_ORIGINS=https://app.yourdomain.com
# Deployment env (production|prod gates docs). [str, optional]
ENVIRONMENT=
# Alt deployment env var (see ENVIRONMENT). [str, optional]
APP_ENV=
# Alt deployment env var (see ENVIRONMENT). [str, optional]
FASTAPI_ENV=
# Render platform marker used when ENVIRONMENT is unset. [bool, optional]
RENDER=
# Expose /docs & /openapi.json in production (default off in prod). [bool, optional]
PUBLIC_API_DOCS_ENABLED=
# SSE keepalive comment cadence. [int, optional]
SSE_KEEPALIVE_SECONDS=20
# Hard cap on concurrent SSE streams per process (503 beyond). [int, optional]
SSE_MAX_CONNECTIONS=200
# Default GET /api/startups page size. [int, optional]
STARTUPS_LIST_DEFAULT_LIMIT=250
# Max GET /api/startups page size. [int, optional]
STARTUPS_LIST_MAX_LIMIT=500

# === Concurrency / loops ===
# Max concurrent pipeline cycles (keep 1 on small instances). [int, optional]
MAX_CONCURRENT_PIPELINE_CYCLES=1
# Max concurrent on-demand lookups. [int, optional]
MAX_CONCURRENT_LOOKUPS=2
# Per-call reference probe concurrency; the process-wide pool remains capped at 8. [int, optional]
REFERENCE_PROBE_CONCURRENCY=8
# Lifetime of a server-side dispatch resolution token (capped at 15 minutes). [int, optional]
LOOKUP_RESOLUTION_TTL_SECONDS=300
# Maximum short-lived company resolutions retained per API process. [int, optional]
LOOKUP_RESOLUTION_CACHE_MAX=512
# Per-user persistent loop tick. [int, optional]
AGENT_LOOP_INTERVAL_SECONDS=300
# Resume every user's agent loop at boot (disable on tiny instances). [bool, optional]
RESUME_AGENT_LOOPS_ON_STARTUP=true
# Cap resumed loops after restart (0=no cap). [int, optional]
MAX_RESUMED_AGENT_LOOPS=0
# Process RSS sampler cadence (0=off). [int, optional]
RSS_SAMPLER_INTERVAL_SECONDS=60
# Event-loop lag sampler cadence (0=off). [int, optional]
LOOP_LAG_SAMPLER_INTERVAL_SECONDS=5
# Log a warning when sampled event-loop lag exceeds this. [float, optional]
LOOP_LAG_WARN_SECONDS=0.25
# glibc malloc arena cap (RSS control). [int, optional]
MALLOC_ARENA_MAX=2
# Distributed lock TTL for agent trigger. [int, optional]
AGENT_TRIGGER_LOCK_TTL_SECONDS=900
# Distributed lock TTL for lookups. [int, optional]
LOOKUP_LOCK_TTL_SECONDS=900
# Distributed lock TTL for meta trigger. [int, optional]
META_TRIGGER_LOCK_TTL_SECONDS=900
# Max remembered cancelled lookup ids. [int, optional]
CANCELLED_LOOKUP_MAX=1000
# Process-level tenant id for background agent workers. [str, optional]
AETHRIA_AGENT_USER_ID=

# === Scout ===
# Scout engine interval. [int, optional]
SCOUT_INTERVAL_SECONDS=300
# Unreviewed backlog that throttles scouting. [int, optional]
SCOUT_BACKPRESSURE_THRESHOLD=10
# Backlog below which scouting ramps up. [int, optional]
SCOUT_RAMP_THRESHOLD=5
# Max scout waves per ramped cycle. [int, optional]
SCOUT_RAMP_MAX_WAVES=2
# Slots reserved for recency/breaking-news scouts. [int, optional]
SCOUT_RECENCY_RESERVED_SLOTS=5
# Max open-discovery retrieval queries per scout persona (thesis-derived). [int, optional]
SCOUT_DISCOVERY_MAX_QUERIES=3
# Max web-search results per scout query. [int, optional]
SCOUT_RETRIEVAL_MAX_RESULTS=10
# Cap on merged retrieval results. [int, optional]
SCOUT_RETRIEVAL_MERGED_CAP=16
# Max references kept during enrichment. [int, optional]
SCOUT_ENRICH_MAX_REFERENCES=12
# Min confidence to enrich a scout result. [float, optional]
SCOUT_ENRICH_MIN_CONFIDENCE=0.4

# === Founder resolution ===
# Run the deterministic founder-resolution stage after company resolution. [bool, optional]
FOUNDER_RESOLUTION_ENABLED=true
# Min candidate confidence to promote a founder name onto ScoutInfo. The full structured resolution is stored regardless. [float, optional]
FOUNDER_RESOLUTION_MIN_CONFIDENCE=0.35
# Cap on founder names promoted onto ScoutInfo (ScoutInfo allows at most 8). [int, optional]
FOUNDER_RESOLUTION_MAX_NAMES=8
# Read the company's own team/about pages in full during founder resolution. Search snippets truncate these pages, which is why listed founders were missed. [bool, optional]
FOUNDER_TEAM_PAGE_EXTRACTION=true
# Max company pages fetched per founder resolution (extract accepts at most 3). [int, optional]
FOUNDER_TEAM_PAGE_MAX=2
# Allow reviewer-side founder resolution to run extra searches when the reviewer gap-retrieval pack names nobody. Off by default so reviews add no retrieval. [bool, optional]
REVIEWER_FOUNDER_FALLBACK_RETRIEVAL=false

# === Reviewer ===
# Reviewer engine interval. [int, optional]
REVIEWER_INTERVAL_SECONDS=60
# Reviewer batch size per cycle. [int, optional]
REVIEWER_BATCH_SIZE=3
# Undecided backlog that throttles review. [int, optional]
REVIEWER_BACKPRESSURE_THRESHOLD=10
# Backlog below which review ramps up. [int, optional]
REVIEWER_RAMP_THRESHOLD=5
# Max batch size when ramped. [int, optional]
REVIEWER_RAMP_BATCH_MAX=5
# Override max completion tokens (empty=model default). [int, optional]
REVIEWER_MAX_COMPLETION_TOKENS=
# Max gap-retrieval results per query. [int, optional]
REVIEWER_GAP_MAX_PER_QUERY=6
# Max gap-retrieval sources total. [int, optional]
REVIEWER_GAP_MAX_SOURCES=12

# === Partner ===
# Allow LLM fallback for partner edge cases. [bool, optional]
PARTNER_USE_LLM=true
# Partner engine interval. [int, optional]
PARTNER_INTERVAL_SECONDS=30
# Max decisions per partner cycle. [int, optional]
PARTNER_BATCH_MAX=20
# Log full partner LLM prompts/responses. [bool, optional]
PARTNER_LLM_DEBUG_LOGS=
# Include deal-context digest in partner prompt. [bool, optional]
PARTNER_LLM_INCLUDE_DEAL_CONTEXT_DIGEST=

# === Meta-agent ===
# Enable the self-optimization meta-agent. [bool, optional]
META_AGENT_ENABLED=true
# Meta-agent run interval (daily). [int, optional]
META_AGENT_INTERVAL_SECONDS=86400
# Min decisions before meta acts. [int, optional]
META_AGENT_MIN_DECISIONS=10
# Min reviews before meta acts. [int, optional]
META_AGENT_MIN_REVIEWS=20
# Cycles between prompt mutations. [int, optional]
META_AGENT_MUTATION_COOLDOWN_CYCLES=3
# Auto-apply mutated prompts without review. [bool, optional]
META_AGENT_PROMPT_AUTO_APPLY=false
# Concurrency for prompt evaluation. [int, optional]
META_PROMPT_EVAL_CONCURRENCY=3
# Max acceptable mean score delta in eval. [float, optional]
META_PROMPT_EVAL_MAX_MEAN_DELTA=2.5
# Max startups per prompt eval run. [int, optional]
META_PROMPT_EVAL_MAX_STARTUPS=20
# How long an eval pass stays fresh. [int, optional]
META_PROMPT_EVAL_PASS_TTL_HOURS=24
# Max size of the eval startup set. [int, optional]
META_PROMPT_EVAL_SET_MAX=50
# Require a fresh eval pass before a prompt can be promoted. [bool, optional]
META_PROMPT_REQUIRE_EVAL_PASS=

# === Fund thesis ===
# Active-thesis cache TTL. [int, optional]
FUND_THESIS_CACHE_TTL_SECONDS=10
# Model for parsing fund config to thesis. [str, optional]
FUND_THESIS_PARSE_MODEL=gpt-4o-mini
# Embedding model for thesis vectors. [str, optional]
FUND_THESIS_EMBED_MODEL=text-embedding-3-small
# Max rows scanned for runtime thesis-alignment stats. [int, optional]
FUND_THESIS_RUNTIME_ALIGNMENT_ROW_LIMIT=500

# === Portfolio ===
# Max positions scanned per execution cycle. [int, optional]
PORTFOLIO_EXECUTION_SCAN_LIMIT=200
# Max rows for concentration clustering. [int, optional]
PORTFOLIO_CLUSTER_ANALYSIS_LIMIT=500

# === Search providers ===
# Provider name for general search (default: configured retrieval chain). [str, optional]
SEARCH_PROVIDER_GENERAL=
# Provider name for recency/news search (default: configured retrieval chain). [str, optional]
SEARCH_PROVIDER_NEWS=
# Provider name for company identity search (default: configured retrieval chain). [str, optional]
SEARCH_PROVIDER_COMPANY=
# Provider name for founder/people search (default: configured retrieval chain). [str, optional]
SEARCH_PROVIDER_PEOPLE=
# Retrieval chain order, best-first. DuckDuckGo is always the final keyless fallback. [str, optional]
RETRIEVAL_PROVIDER_ORDER=exa,firecrawl
# Rollback lever: moves one provider (exa|firecrawl) to the head of the chain. [str, optional]
RETRIEVAL_PRIMARY_PROVIDER=
# Use the keyless DuckDuckGo retrieval when the whole provider chain returns nothing. [bool, optional]
RETRIEVAL_FALLBACK_ENABLED=1
# Freshness window for general retrieval cache entries. [int, optional]
RETRIEVAL_CACHE_TTL_GENERAL_SECONDS=86400
# Freshness window for news retrieval cache entries. [int, optional]
RETRIEVAL_CACHE_TTL_NEWS_SECONDS=21600
# Freshness window for company retrieval cache entries. [int, optional]
RETRIEVAL_CACHE_TTL_COMPANY_SECONDS=604800
# Freshness window for people retrieval cache entries. [int, optional]
RETRIEVAL_CACHE_TTL_PEOPLE_SECONDS=604800
# Retrieval queries in flight at once within one merged pack (1 = sequential). Merge order stays deterministic regardless of this value. [int, optional]
RETRIEVAL_QUERY_CONCURRENCY=4

# === Exa ===
# Exa API key for semantic search and company discovery. [secret, optional]
EXA_API_KEY=
# Exa request timeout (s). [float, optional]
EXA_TIMEOUT=20.0
# Cap on Exa results per query. [int, optional]
EXA_MAX_RESULTS_CAP=15
# Retries for Exa 429 and 5xx responses. [int, optional]
EXA_MAX_RETRIES=2
# Exa search mode (auto|fast|instant). Research/agent modes are deliberately not allowed. [str, optional]
EXA_SEARCH_TYPE=auto
# Max Exa highlight chars kept per result. [int, optional]
EXA_HIGHLIGHT_MAX_CHARS=1200
# Scrape top Exa URLs through Firecrawl for page content. [bool, optional]
EXA_ENRICH_WITH_FIRECRAWL=1
# Max Exa URLs sent to Firecrawl per query (also bounded by FIRECRAWL_SCRAPE_MAX_URLS). [int, optional]
EXA_ENRICH_MAX_URLS=3
# Comma-separated domain allowlist for Exa results. [str, optional]
EXA_INCLUDE_DOMAINS=
# Comma-separated domain denylist for Exa results (ignored for company/people categories). [str, optional]
EXA_EXCLUDE_DOMAINS=

# === Firecrawl ===
# Firecrawl v2 API key for retrieval. [secret, optional]
FIRECRAWL_API_KEY=
# Firecrawl request timeout (s). [float, optional]
FIRECRAWL_TIMEOUT=20.0
# Cap on Firecrawl results per query. [int, optional]
FIRECRAWL_MAX_RESULTS_CAP=15
# Retries for Firecrawl 429 and 5xx responses. [int, optional]
FIRECRAWL_MAX_RETRIES=2
# Request markdown in Firecrawl search results. [bool, optional]
FIRECRAWL_INCLUDE_MARKDOWN=1
# Max Firecrawl markdown chars kept per result. [int, optional]
FIRECRAWL_MARKDOWN_MAX_CHARS=4500
# Max URLs sent to Firecrawl scrape. [int, optional]
FIRECRAWL_SCRAPE_MAX_URLS=3

# === Admin ===
# Enable the admin dashboard (default on outside prod, off in prod unless set). [bool, optional]
ADMIN_DASHBOARD_ENABLED=
# Shared secret for admin login. [secret, optional]
ADMIN_DASHBOARD_SECRET=
# HMAC secret for admin session tokens. [secret, optional]
ADMIN_TOKEN_SECRET=
# Admin session token TTL. [int, optional]
ADMIN_TOKEN_TTL_MINUTES=60
# Admin login failures before throttling. [int, optional]
ADMIN_LOGIN_MAX_FAILURES=5
# Admin login failure window. [int, optional]
ADMIN_LOGIN_WINDOW_SECONDS=300

# === Observability ===
# Expose the Prometheus /metrics endpoint. [bool, optional]
METRICS_ENABLED=true
# If set, /metrics requires this value as a Bearer token. Leave empty only on a trusted/private network. [secret, optional]
METRICS_TOKEN=

# === Event bus ===
# SSE event fan-out: 'memory' (single instance) or 'postgres' (LISTEN/NOTIFY for multi-instance delivery). [str, optional]
EVENT_BUS_BACKPLANE=memory
# Explicitly acknowledge single-instance process-local queues/cancellation state. [bool, optional]
ALLOW_PROCESS_LOCAL_STATE=false
# Direct Postgres connection string for the LISTEN/NOTIFY backplane. Required when EVENT_BUS_BACKPLANE=postgres. [secret, optional]
DATABASE_URL=

# === Local snapshot validation ===
# Local production-snapshot DSN used only by bounded import/validation tooling. [secret, optional]
SNAPSHOT_DATABASE_URL=

# === Durable jobs ===
# Minimum direct-Postgres connections reserved for durable jobs. [int, optional]
DURABLE_JOB_DB_POOL_MIN=1
# Maximum direct-Postgres connections used by durable jobs. [int, optional]
DURABLE_JOB_DB_POOL_MAX=4
# Database command timeout for durable job operations. [float, optional]
DURABLE_JOB_DB_COMMAND_TIMEOUT_SECONDS=30
# Timed polling backstop when no job notification arrives. [float, optional]
DURABLE_JOB_POLL_SECONDS=2
# Duration of an execution lease before another worker may recover it. [int, optional]
DURABLE_JOB_LEASE_SECONDS=90
# Heartbeat cadence for extending an active execution lease. [float, optional]
DURABLE_JOB_HEARTBEAT_SECONDS=20
# Maximum durable jobs executing concurrently in one API process. [int, optional]
DURABLE_JOB_GLOBAL_CONCURRENCY=1
# Maximum durable jobs executing concurrently for one tenant. [int, optional]
DURABLE_JOB_TENANT_CONCURRENCY=1
# Polling cadence for transactional outbox publication. [float, optional]
DURABLE_OUTBOX_POLL_SECONDS=2

# === Canonical identity ===
# Minimum deterministic confidence for one picker candidate to be eligible for automatic identity resolution. [float, optional]
IDENTITY_AUTO_RESOLVE_CONFIDENCE=0.85

# === Monitoring ===
# Maximum per-tenant daily reserved plus settled evidence-refresh cost. [float, optional]
MONITOR_DAILY_BUDGET_USD=10

# === Scoring / misc ===
# Use the deterministic structured scoring engine. [bool, optional]
USE_STRUCTURED_SCORING=true
# Publish confidence-discounted, evidence-capped legacy display scores. [bool, optional]
SCORING_EVIDENCE_CALIBRATION_ENABLED=true
# Skip score enrichment on read (perf). [bool, optional]
SKIP_READ_ENRICH_SCORES=
# Verbose scoring debug logs. [bool, optional]
DEBUG_SCORING=false
# Max chars per retrieval snippet. [int, optional]
RETRIEVAL_SNIPPET_MAX_CHARS=2800
# Recency window for breaking-news weighting. [int, optional]
RECENCY_WINDOW_MONTHS=12
# Timeout fetching a looked-up website. [float, optional]
LOOKUP_WEBSITE_FETCH_TIMEOUT=5.0
# Log deal-context assembly during pipeline. [bool, optional]
DEAL_CONTEXT_LOG_PIPELINE=
# Assumed $/1k tokens for cost estimates. [float, optional]
AETHRIA_TOKEN_COST_PER_1K_USD=0.001

# === Local contract tests ===
# Vanilla PostgreSQL DSN used only by PostgreSQL contract tests. [secret, optional]
TEST_DATABASE_URL=
