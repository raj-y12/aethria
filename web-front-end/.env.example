# Private app iframe (/private-access): URL of the deployed app-front-end.
# Required in production (e.g. Vercel). Set in Vercel → Project → Settings → Environment Variables.
# VITE_APP_URL=https://app.yourdomain.com

# Clerk publishable key used by the React apps.
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Vercel serverless function (api/waitlist.ts) — both required, set in Vercel
# Project Settings. The function fails closed (503) if either is unset.
# RESEND_API_KEY=re_xxxxxxxxx
# AETHRIA_WAITLIST_NOTIFY_EMAIL=you@example.com
