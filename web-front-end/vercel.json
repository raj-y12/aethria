{
  "rewrites": [
    { "source": "/home", "destination": "/home.html" },
    { "source": "/demo", "destination": "https://app.aethria.co/demo" },
    { "source": "/demo/:path*", "destination": "https://app.aethria.co/demo/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
