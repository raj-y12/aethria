# macOS / editor noise
.DS_Store
.cursorignore
.cursor/
.playwright-mcp/
/*.jpg

# Local environment files. Keep examples committed.
.env
.env.*
!.env.example
!**/.env.example

# JavaScript / frontend generated files
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# Python generated files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
ENV/
.superpowers/

# Logs and runtime output
logs/
*.log

# Local agent/worktree state
app-front-end/.superpowers/
.worktrees/
.claude/worktrees/

# Generated Graphify knowledge graph. Regenerate with scripts/update_graph.sh —
# it is large, machine-specific, and never a source of truth.
graphify-out/

# Archived experiments and local maintenance scratch space at the repository
# root. Checked-in maintenance scripts are re-included individually below.
/scripts/*
!/scripts/update_graph.sh
unused_components/

# Local JSON fallback store (Supabase is the source of truth in prod).
# Self-initializing on first run — never commit its contents.
data/portfolio/
backend/data/

# Supabase CLI local state
supabase/.temp/

# Local agent/critique tool output
.agent/
.impeccable/critique/

# Local developer tools and generated tool output
tools/

# Checked-in maintenance scripts
!backend/scripts/
!backend/scripts/**
!app-front-end/scripts/
!app-front-end/scripts/**
!web-front-end/scripts/
!web-front-end/scripts/**
