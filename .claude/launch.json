{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-front-end",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web-front-end", "run", "dev", "--", "--port", "3100", "--strictPort"],
      "port": 3100
    },
    {
      "name": "app-front-end",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd app-front-end && npm run dev -- --port ${PORT:-3200}"],
      "port": 3200,
      "autoPort": true
    },
    {
      "name": "app-screenshot-harness",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd app-front-end && npx vite --config vite.screenshot.config.ts --port ${PORT:-5181}"],
      "port": 5181,
      "autoPort": true
    },
    {
      "name": "brand-assets",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "serve", "brand-assets", "-l", "4400"],
      "port": 4400
    }
  ]
}
