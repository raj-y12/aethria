# Secrets — never bake into image
.env
.env.*
!.env.example
!**/.env.example

# Python caches and virtualenvs
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
ENV/

# Logs
logs/
*.log

# Frontend artifacts
node_modules/
**/node_modules/
dist/
**/dist/
.vite/

# Git and editor noise
.git/
.gitignore
.DS_Store
.cursorignore

# Local runtime data (use Supabase in Docker; mount volume if needed for file fallback)
backend/data/

# Not needed at runtime — shrink build context
docs/
app-front-end/
web-front-end/
scripts/
.worktrees/
packages/
supabase/
unused_components/
